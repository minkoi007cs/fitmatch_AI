{
  "$id": "https://fitmatch.local/schemas/v1-r2/model-request.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "avatar"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "inputAssetIds": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "heightCm": {
          "type": "number",
          "minimum": 100,
          "maximum": 230
        },
        "videoAssetId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "faceAssetIds": {
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "measurements": {
          "type": "object",
          "properties": {
            "chestCm": {
              "type": "number",
              "minimum": 50,
              "maximum": 180
            },
            "waistCm": {
              "type": "number",
              "minimum": 40,
              "maximum": 180
            },
            "hipCm": {
              "type": "number",
              "minimum": 50,
              "maximum": 180
            },
            "shoulderCm": {
              "type": "number",
              "minimum": 25,
              "maximum": 70
            },
            "inseamCm": {
              "type": "number",
              "minimum": 40,
              "maximum": 110
            },
            "weightKg": {
              "type": "number",
              "minimum": 25,
              "maximum": 250
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "name",
        "inputAssetIds",
        "heightCm"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "garment"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "inputAssetIds": {
          "minItems": 2,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "wardrobeItemId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "kind",
        "name",
        "inputAssetIds",
        "wardrobeItemId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "fitting"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "avatarId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "garmentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "kind",
        "name",
        "avatarId",
        "garmentId"
      ],
      "additionalProperties": false
    }
  ]
}
