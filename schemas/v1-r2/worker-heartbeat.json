{
  "$id": "https://fitmatch.local/schemas/v1-r2/worker-heartbeat.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "capabilities": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "avatar.reconstruct",
          "garment.reconstruct",
          "garment.drape",
          "bottom.reconstruct",
          "bottom.drape"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "required": [
          "model",
          "revision"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "capabilities"
  ],
  "additionalProperties": false
}
