{
  "$id": "https://fitmatch.local/schemas/v1-r2/avatar-measurements.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "chestCm": {
      "type": "number",
      "minimum": 50,
      "maximum": 180
    },
    "waistCm": {
      "type": "number",
      "minimum": 40,
      "maximum": 180
    },
    "hipCm": {
      "type": "number",
      "minimum": 50,
      "maximum": 180
    },
    "shoulderCm": {
      "type": "number",
      "minimum": 25,
      "maximum": 70
    },
    "inseamCm": {
      "type": "number",
      "minimum": 40,
      "maximum": 110
    },
    "weightKg": {
      "type": "number",
      "minimum": 25,
      "maximum": 250
    }
  },
  "additionalProperties": false
}
