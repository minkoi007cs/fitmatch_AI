+        account = Accounting()
+        if query_job(job, 1, C.byref(account), C.sizeof(account), None):
+            if account.activeProcesses == 0:
+                record.update(allJobProcessesExited=True, activeProcessesAtDrain=0,
+                              drainVerifiedAtUtc=utc())
+                return
+        else:
+            record.update(status='quarantined', allJobProcessesExited=False)
+            try:
+                write(STATE, record)
+            except OSError:
+                pass  # keep the Job Object and OS lock even if its diagnostic receipt cannot be written
+        time.sleep(.05)
 
