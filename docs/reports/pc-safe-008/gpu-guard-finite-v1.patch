+def finite_number(value, label, maximum=MAX_TIMESTAMP):
+    if type(value) not in (int, float):
+        raise ValueError('Invalid numeric GPU ' + label)
+    try:
+        valid = math.isfinite(value) and 0 < value <= maximum
+    except OverflowError:
+        valid = False
+    if not valid:
+        raise ValueError('Invalid finite GPU ' + label)
+    return value
+
+
+def validate_slot(slot, now):
+    now = finite_number(now, 'clock')
+    allowed = {'version', 'owner', 'issuedAtUtc', 'issuedAtUnix', 'admitUntilUnix', 'policy'}
+    if type(slot) is not dict or set(slot) - allowed or slot.get('owner') not in ('pc-3d', 'pc-ai'):
+        raise ValueError('Invalid GPU admission object/owner')
+    version = slot.get('version', 0)
+    if type(version) is not int or version not in (0, 1):
+        raise ValueError('Invalid GPU admission revision')
+    issued_text = slot.get('issuedAtUtc')
+    if type(issued_text) is not str or len(issued_text) > 40:
+        raise ValueError('Invalid GPU issue time')
+    try:
+        date = datetime.fromisoformat(issued_text.replace('Z', '+00:00'))
+        if date.utcoffset() != timezone.utc.utcoffset(date):
+            raise ValueError('GPU issue time must be UTC')
+        issued = finite_number(date.timestamp(), 'issue time')
+    except (OverflowError, OSError) as error:
+        raise ValueError('Invalid GPU issue time') from error
+    if version == 1 or 'issuedAtUnix' in slot:
+        numeric_issue = finite_number(slot.get('issuedAtUnix'), 'issue time')
+        if abs(numeric_issue - issued) > .001:
+            raise ValueError('GPU issue times disagree')
+        # Use the checked numeric issue consistently for the window. ISO has
+        # microsecond precision, while time.time() can retain sub-microseconds.
+        issued = numeric_issue
+    expiry = finite_number(slot.get('admitUntilUnix'), 'expiry')
+    duration = expiry - issued
+    if not 0 < duration <= MAX_SLOT_SECONDS or issued > now + CLOCK_SKEW_SECONDS or expiry <= now:
+        raise ValueError('Invalid or expired GPU admission window')
+    if 'policy' in slot and (type(slot['policy']) is not str or len(slot['policy']) > 160):
+        raise ValueError('Invalid GPU admission policy')
+    return slot['owner']
+
