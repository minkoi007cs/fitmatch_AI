{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "category",
    "dominant_colors",
    "pattern",
    "logo_presence",
    "logo_texts",
    "neckline",
    "sleeves",
    "material_composition",
    "back_pocket_count",
    "pockets_total"
  ],
  "properties": {
    "schema_version": {
      "const": "pc-ai.grounded-attributes.v2"
    },
    "category": {
      "enum": [
        "tshirt",
        "jeans",
        "unknown"
      ]
    },
    "dominant_colors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "blue",
          "white",
          "black",
          "gray",
          "red",
          "green",
          "yellow",
          "brown",
          "other",
          "unknown"
        ]
      }
    },
    "pattern": {
      "enum": [
        "striped",
        "solid",
        "printed",
        "checked",
        "other",
        "unknown"
      ]
    },
    "logo_presence": {
      "enum": [
        "visible",
        "not_visible",
        "unknown"
      ]
    },
    "logo_texts": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      }
    },
    "neckline": {
      "enum": [
        "crew",
        "v_neck",
        "other",
        "not_applicable",
        "unknown"
      ]
    },
    "sleeves": {
      "enum": [
        "short",
        "long",
        "sleeveless",
        "not_applicable",
        "unknown"
      ]
    },
    "material_composition": {
      "const": "unknown"
    },
    "back_pocket_count": {
      "const": "unknown"
    },
    "pockets_total": {
      "const": "unknown"
    }
  }
}
