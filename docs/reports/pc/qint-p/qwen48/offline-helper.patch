+"""CPU metadata/refusal tests only; never supplies a positive native execution proof."""
+import contextlib
+import hashlib
+import io
+import json
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+from unittest.mock import patch
+
+from PIL import Image
+from boundary import MODEL_REVISION, Refused
+import offline_regression48 as helper
+import wire
+
+
+class OfflinePreparationTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.gpu = Path(self.tmp.name)
+        self.root = self.gpu / 'ai-service/candidate'
+        self.root.mkdir(parents=True)
+        self.private = self.gpu / 'private'
+        self.private.mkdir()
+        self.run = self.private / 'run'
+        self.run.mkdir()
+        self.stack = contextlib.ExitStack()
+        self.addCleanup(self.stack.close)
+        for name, value in [('ROOT', self.root), ('GPU', self.gpu), ('PRIVATE', self.private)]:
+            self.stack.enter_context(patch.object(helper, name, value))
+        files = []
+        for name in ['offline_regression48.py', 'assessment48.py', 'runner.py', 'wire.py', 'admission.py']:
+            path = self.root / name
+            path.write_text('# metadata-only CPU source fixture\n')
+            files.append({'path': path.relative_to(self.gpu).as_posix(), 'sha256': helper.digest(path)})
+        self.manifest = self.private / 'manifest.json'
+        self.manifest.write_text(json.dumps({'kind': 'qwen48.reviewed-runtime.v1',
+            'reviewedCPUCommit': 'a' * 40, 'appRevision': 'b' * 40, 'files': files}))
+        image = self.run / 'input.jpg'
+        Image.new('RGB', (64, 64), 'blue').save(image)
+        self.value = json.loads((wire.SNAPSHOT / 'fixtures/qwen-v1/adapter-input.json').read_text())
+        self.value['modelRevision']['revision'] = MODEL_REVISION
+        image_hash = helper.digest(image)
+        self.value['assets'][0].update(localPath=str(image), sha256=image_hash, bytes=image.stat().st_size)
+        self.value['binding']['imageSha256'] = image_hash
+        self.value['outputPath'] = str(self.run / 'result.json')
+        self.request = self.run / 'input.json'
+        self.request.write_text(json.dumps(self.value))
+        self.plan = {'kind': 'qwen48.offline-approval.v1', 'enabled': False,
+            'scope': 'private_existing_input_no_network', 'candidateRoot': str(self.root),
+            'engineSeconds': 240, 'drainSeconds': 30, 'appRevision': 'b' * 40,
+            'label': 'cpu-metadata-fixture', 'runRoot': str(self.run),
+            'runtimeManifestPath': str(self.manifest), 'runtimeManifestSHA256': helper.digest(self.manifest),
+            'requestPath': str(self.request), 'requestSHA256': helper.digest(self.request),
+            'reviewedCPUCommit': 'a' * 40}
+        self.approval = self.private / 'approval.json'
+        self.save()
+
+    def save(self):
+        self.approval.write_text(json.dumps(self.plan))
+
+    def invoke(self, *extra):
+        out = io.StringIO()
+        with contextlib.redirect_stdout(out):
+            code = helper.main(['--request', str(self.request), '--approval', str(self.approval), *extra])
+        return code, json.loads(out.getvalue())
+
+    def test_default_inspects_exact_private_bytes_without_execution(self):
+        code, out = self.invoke()
+        self.assertEqual(code, 0)
+        self.assertEqual(out['status'], 'cpu_inspection_passed')
+        self.assertFalse(out['torchImported'])
+        self.assertFalse(out['networkUsed'])
+        self.assertFalse((self.run / 'result.json').exists())
+        self.assertFalse((self.run / 'execution-started.json').exists())
+
+    def test_disabled_execute_refuses_before_native_or_backend(self):
+        with patch.object(helper.admission, 'verify', side_effect=AssertionError('must not be called')) as native:
+            code, out = self.invoke('--execute', '--guard-label', self.plan['label'])
+        self.assertEqual(code, 75)
+        self.assertEqual(out['code'], 'offline_approval_disabled')
+        native.assert_not_called()
+        self.assertNotIn('torch', sys.modules)
+        self.assertFalse((self.run / 'execution-started.json').exists())
+
+    def test_label_mismatch_refuses_before_native(self):
+        self.plan['enabled'] = True
+        self.save()
+        code, out = self.invoke('--execute', '--guard-label', 'different')
+        self.assertEqual(code, 75)
+        self.assertEqual(out['code'], 'offline_guard_label_mismatch')
+
+    def test_source_tamper_refuses_before_image_or_model(self):
+        (self.root / 'assessment48.py').write_text('# changed source')
+        self.assertEqual(self.invoke()[1]['code'], 'offline_source_changed')
+
+    def test_request_and_image_tamper_refuse(self):
+        original = self.request.read_bytes()
+        self.request.write_text('{}')
+        self.assertEqual(self.invoke()[1]['code'], 'offline_request_changed')
+        self.request.write_bytes(original)
+        (self.run / 'input.jpg').write_bytes(b'not the pinned image')
+        self.assertNotEqual(self.invoke()[0], 0)
+        self.assertNotIn('torch', sys.modules)
+
+    def test_used_run_never_overwrites_old_result(self):
+        output = self.run / 'result.json'
+        output.write_bytes(b'preserve')
+        self.assertEqual(self.invoke()[1]['code'], 'offline_run_already_used')
+        self.assertEqual(output.read_bytes(), b'preserve')
+
+    def test_incomplete_or_traversal_manifest_refused(self):
+        manifest = json.loads(self.manifest.read_text())
+        for bad_files in [manifest['files'][1:], [{'path': '../escape', 'sha256': 'a' * 64}]]:
+            self.manifest.write_text(json.dumps({**manifest, 'files': bad_files}))
+            self.plan['runtimeManifestSHA256'] = helper.digest(self.manifest)
+            self.save()
+            self.assertNotEqual(self.invoke()[0], 0)
+
+    def test_approval_duplicate_key_refused(self):
+        self.approval.write_text('{"enabled":false,"enabled":true}')
+        self.assertNotEqual(self.invoke()[0], 0)
+
+    def test_plan_cannot_redirect_output_or_run_outside_private_root(self):
+        self.plan['runRoot'] = str(self.gpu / 'not-private')
+        self.save()
+        self.assertEqual(self.invoke()[1]['code'], 'offline_run_root')
+
+    def test_worker_credential_cannot_enter_offline_execution(self):
+        self.plan['enabled'] = True
+        self.save()
+        with patch.dict('os.environ', {'FITMATCH_WORKER_TOKEN': 'synthetic_CPU_only'}):
+            code, out = self.invoke('--execute', '--guard-label', self.plan['label'])
+        self.assertEqual(code, 75)
+        self.assertEqual(out['code'], 'offline_worker_credential_present')
+
+
+if __name__ == '__main__':
+    unittest.main(verbosity=2)
