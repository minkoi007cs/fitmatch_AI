{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "confirmation_id",
    "result_id",
    "expected_envelope_digest",
    "binding",
    "decision",
    "approved_fields"
  ],
  "properties": {
    "contract_version": {
      "const": "pc-ai.human-confirmation.v1"
    },
    "confirmation_id": {
      "type": "string",
      "format": "uuid"
    },
    "result_id": {
      "type": "string",
      "format": "uuid"
    },
    "expected_envelope_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_id",
        "job_id",
        "item_id",
        "source_revision",
        "image_sha256"
      ],
      "properties": {
        "owner_id": {
          "type": "string",
          "format": "uuid"
        },
        "job_id": {
          "type": "string",
          "format": "uuid"
        },
        "item_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_revision": {
          "type": "string",
          "format": "uuid"
        },
        "image_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "decision": {
      "enum": [
        "approve_fields",
        "reject",
        "needs_input"
      ]
    },
    "approved_fields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "tshirt",
            "jeans",
            "unknown"
          ]
        },
        "dominant_colors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "blue",
              "white",
              "black",
              "gray",
              "red",
              "green",
              "yellow",
              "brown",
              "other",
              "unknown"
            ]
          }
        },
        "logo_presence": {
          "enum": [
            "visible",
            "not_visible",
            "unknown"
          ]
        },
        "logo_texts": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        },
        "neckline": {
          "enum": [
            "crew",
            "v_neck",
            "other",
            "not_applicable",
            "unknown"
          ]
        },
        "pattern": {
          "enum": [
            "striped",
            "solid",
            "printed",
            "checked",
            "other",
            "unknown"
          ]
        },
        "sleeves": {
          "enum": [
            "short",
            "long",
            "sleeveless",
            "not_applicable",
            "unknown"
          ]
        }
      }
    }
  }
}
